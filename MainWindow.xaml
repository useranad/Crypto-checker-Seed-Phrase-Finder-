<Window x:Class="CryptoChecker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Crypto Balance Checker | t.me/notcoin2055"
        Height="640" Width="980"
        WindowStartupLocation="CenterScreen"
        Background="#FFF5F5F5">
    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <TextBlock Text="Crypto Checker seed phrases (demo source)"
                       FontSize="20" FontWeight="SemiBold" Margin="0,0,0,6"/>
            <TextBlock Text="Educational UI demo. Balance values are simulated."
                       Foreground="#FF666666" Margin="0,0,0,10"/>

            <TextBlock Text="Enter mnemonic phrases or Private Keys (one per line)" Margin="0,0,0,4"/>
            <TextBox x:Name="InputBox"
                     Height="110"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     FontFamily="Consolas"/>

            <WrapPanel Margin="0,10,0,6">
                <CheckBox x:Name="CheckBtc" Content="BTC" Margin="4" IsChecked="True"/>
                <CheckBox x:Name="CheckEth" Content="ETH" Margin="4" IsChecked="True"/>
                <CheckBox x:Name="CheckBsc" Content="BSC" Margin="4" IsChecked="True"/>
                <CheckBox x:Name="CheckLtc" Content="LTC" Margin="4" IsChecked="True"/>
                <CheckBox x:Name="CheckSol" Content="SOL" Margin="4" IsChecked="True"/>
                <CheckBox x:Name="CheckPolygon" Content="MATIC" Margin="4" IsChecked="True"/>
                <CheckBox x:Name="CheckAvalanche" Content="AVAX" Margin="4" IsChecked="True"/>
                <CheckBox x:Name="CheckArbitrum" Content="ARB" Margin="4" IsChecked="True"/>
                <CheckBox x:Name="CheckBase" Content="BASE" Margin="4" IsChecked="True"/>
                <CheckBox x:Name="CheckOptimism" Content="OP" Margin="4" IsChecked="True"/>
                <CheckBox x:Name="CheckGnosis" Content="GNOSIS" Margin="4" IsChecked="True"/>
                <CheckBox x:Name="CheckUnichain" Content="UNI" Margin="4" IsChecked="True"/>
                <CheckBox x:Name="CheckBerachain" Content="BERA" Margin="4" IsChecked="True"/>
                <CheckBox x:Name="CheckXrp" Content="XRP" Margin="4" IsChecked="True"/>
                <CheckBox x:Name="CheckTrx" Content="TRX" Margin="4" IsChecked="True"/>
            </WrapPanel>

            <StackPanel Orientation="Horizontal">
                <Button Content="Check Balances" Width="140" Height="34" Margin="0,0,8,0"
                        Click="CheckBalances_Click" Background="#FF0D6EFD" Foreground="White"/>
                <Button Content="Clear" Width="90" Height="34" Margin="0,0,8,0"
                        Click="Clear_Click" Background="#FFDC3545" Foreground="White"/>
                <TextBlock x:Name="StatusText" VerticalAlignment="Center" Foreground="#FF444444"
                           Text="Ready"/>
            </StackPanel>
        </StackPanel>

        <StatusBar DockPanel.Dock="Bottom" Margin="0,8,0,0">
            <StatusBarItem>
                <TextBlock x:Name="StatsText" Text="Processed: 0 | With balance: 0"/>
            </StatusBarItem>
        </StatusBar>

        <DataGrid x:Name="ResultsGrid"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  HeadersVisibility="Column">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Mnemonic" Binding="{Binding Phrase}" Width="2*"/>
                <DataGridTextColumn Header="Network" Binding="{Binding Network}" Width="*"/>
                <DataGridTextColumn Header="Address" Binding="{Binding Address}" Width="2*"/>
                <DataGridTextColumn Header="Balance" Binding="{Binding Balance}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
